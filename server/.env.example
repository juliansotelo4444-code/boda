# Puerto del servidor
PORT=5000

# URL de conexión a PostgreSQL en Neon (usar la URL pooled de Neon recomendada para apps web)
# Ejemplo: postgresql://neondb_owner:PASSWORD@ep-random-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firma de tokens JWT
JWT_SECRET="boda_julian_yanet_secret_key_2027_change_in_production"

# Frontend URL para CORS
FRONTEND_URL="http://localhost:5173"
