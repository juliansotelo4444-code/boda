datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. AUTENTICACIÓN Y CONFIGURACIÓN MAESTRA
// -------------------------------------------------------------
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN") // ADMIN, PLANNER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WeddingSettings {
  id             String   @id @default("singleton")
  groomName      String   @default("Julián")
  brideName      String   @default("Yanet")
  weddingDate    DateTime @default("2027-10-09T18:00:00.000Z")
  venueName      String   @default("Palacio San Souci / Jardines de la Reina")
  venueAddress   String   @default("Av. Libertador 2450, San Fernando")
  primaryColor   String   @default("#67001A") // Burgundy elegante
  secondaryColor String   @default("#D4AF37") // Champagne / Oro cálido
  totalBudget    Decimal  @default(25000.00) @db.Decimal(12, 2)
  currency       String   @default("USD")
  isRsvpOpen     Boolean  @default(true)
  heroTitle      String?  @default("Nos Casamos")
  heroSubtitle   String?  @default("Acompáñanos a celebrar nuestro gran día")
  welcomeText    String?  @db.Text
  updatedAt      DateTime @updatedAt
}

// -------------------------------------------------------------
// 2. GESTOR DE MESAS E INVITADOS
// -------------------------------------------------------------
enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum InvitationDeliveryStatus {
  NOT_SENT
  SENT
  OPENED
  BOUNCED
}

model Table {
  id        String   @id @default(uuid())
  number    Int      @unique
  name      String   // Ej: "Mesa Nupcial (Julián & Yanet)", "Familia Novia"
  capacity  Int      @default(10)
  shape     String   @default("round") // "round", "rectangular", "presidential"
  color     String?  @default("#67001A")
  posX      Float    @default(0) // Coordenadas en plano interactivo
  posY      Float    @default(0)
  guests    Guest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guest {
  id                   String                   @id @default(uuid())
  firstName            String
  lastName             String
  email                String?
  phone                String?
  groupName            String?                  // Ej: "Amigos", "Familia Julián", "Familia Yanet"
  rsvpStatus           RsvpStatus               @default(PENDING)
  plusOnesAllowed      Int                      @default(0)
  plusOnesConfirmed    Int                      @default(0)
  plusOnesNames        String[]                 @default([])
  dietaryRestrictions String[]                 @default([]) // "celiac", "vegan", "vegetarian", "none"
  dietaryNotes         String?
  invitationStatus     InvitationDeliveryStatus @default(NOT_SENT)
  invitationToken      String                   @unique @default(uuid())
  invitationSentAt     DateTime?
  tableId              String?
  table                Table?                   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([rsvpStatus])
  @@index([tableId])
  @@index([groupName])
}

// -------------------------------------------------------------
// 3. CRONOGRAMA DINÁMICO (ITINERARIO DRAG & DROP)
// -------------------------------------------------------------
model TimelineEvent {
  id          String   @id @default(uuid())
  title       String   // Ej: "Recepción de Invitados", "Ceremonia", "Cena", "Fiesta"
  startTime   String   // "18:00"
  endTime     String?  // "19:15"
  location    String?  // "Jardines", "Salón Principal"
  iconName    String?  @default("Clock") // Identificador de icono de Lucide
  orderIndex  Int      @default(0)
  isPublic    Boolean  @default(true)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderIndex])
}

// -------------------------------------------------------------
// 4. PRESUPUESTO, PROVEEDORES Y REGISTRO DE PAGOS
// -------------------------------------------------------------
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model Vendor {
  id          String    @id @default(uuid())
  name        String    // Ej: "Salón San Souci", "DJ & Iluminación"
  category    String    // "Lugar", "Catering", "Fotografía", "Música"
  contactName String?
  phone       String?
  email       String?
  contractUrl String?
  notes       String?   @db.Text
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id            String          @id @default(uuid())
  concept       String          // Ej: "Alquiler de Salón", "Catering Cena", "Vestido de Novia"
  category      String          // "Salón", "Catering", "Foto y Video", "Vestimenta", "Música"
  estimatedCost Decimal         @db.Decimal(12, 2)
  actualCost    Decimal         @db.Decimal(12, 2)
  amountPaid    Decimal         @default(0.00) @db.Decimal(12, 2)
  dueDate       DateTime?
  status        PaymentStatus   @default(PENDING)
  notes         String?         @db.Text
  vendorId      String?
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payments      PaymentRecord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category])
  @@index([status])
  @@index([dueDate])
}

model PaymentRecord {
  id         String   @id @default(uuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime @default(now())
  method     String   @default("Transferencia") // "Transferencia", "Efectivo", "Tarjeta"
  receiptUrl String?
  notes      String?
  createdAt  DateTime @default(now())
}

// -------------------------------------------------------------
// 5. NUESTRA HISTORIA, GALERÍA Y SECCIONES DINÁMICAS
// -------------------------------------------------------------
model StoryMilestone {
  id         String   @id @default(uuid())
  dateOrYear String   // "Mayo 2021", "Nuestra primera cita"
  title      String   // "El primer café juntos"
  narrative  String   @db.Text
  imageUrl   String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderIndex])
}

model GalleryItem {
  id         String   @id @default(uuid())
  title      String?
  imageUrl   String
  caption    String?
  category   String   @default("general") // "compromiso", "viajes", "boda"
  orderIndex Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderIndex])
}

model HoneymoonItem {
  id            String   @id @default(uuid())
  title         String   // "Vuelos a Roma", "Hotel Positano"
  description   String?
  estimatedCost Decimal  @default(0.00) @db.Decimal(12, 2)
  isBooked      Boolean  @default(false)
  link          String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WeddingSong {
  id          String   @id @default(uuid())
  title       String
  artist      String
  moment      String?  // "Entrada", "Vals", "Corte de Tarta", "Fiesta"
  requestedBy String?
  spotifyUrl  String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
}
